{
    "$schema": "https://raw.githubusercontent.com/revisit-studies/study/main/src/parser/StudyConfigSchema.json",
    "studyMetadata": {
        "title": "Zoom Interaction Study",
        "version": "pilot",
        "authors": [
            "VIBE Lab"
        ],
        "date": "2026-01-20",
        "description": "Zoom Interaction Study",
        "organizations": [
            "Washington University in St. Louis"
        ]
    },
    "uiConfig": {
        "contactEmail": "alvitta@wustl.edu",
        "helpTextPath": "zoom-comparison-study/assets/help.md",
        "logoPath": "zoom-comparison-study/assets/logo_b.png",
        "withProgressBar": true,
        "autoDownloadStudy": false,
        "sidebar": true
    },
    "components": {
        "introduction": {
            "type": "markdown",
            "path": "zoom-comparison-study/assets/introduction.md",
            "response": []
        },
        "tutorial": {
            "meta": {
            "difficulty": 0,
            "zoom": "scroll"
          },
          "description": "A chart with correct answer of 0.66",
          "instruction": "Find the as many peaks as you can",
            "type": "react-component",
            "path": "zoom-comparison-study/assets/TutorialEntry.tsx",
            "parameters": {
              "zoomMode": "scroll"
            },
            "nextButtonLocation": "sidebar",
              "response": [
                {
                  "id": "accuracy",
                  "prompt": "Your click distance to circle center",
                  "required": true,
                  "location": "sidebar",
                  "type": "reactive"
                }
              ]
        },
        "chromatogram_scroll": {
          "meta": {
            "difficulty": 0,
            "zoom": "scroll"
          },
          "description": "A chart with correct answer of 0.66",
          "instruction": "Find the as many peaks as you can",
          "type": "react-component",
          "path": "zoom-comparison-study/assets/ChromatogramView.tsx",
          "parameters": {
            "dataPath": "zoom-comparison-study/assets/data/B-Casein_channel1364.json",
            "zoomMode": "scroll"
          }, 
          "nextButtonLocation": "sidebar",
          "response": [
            {
              "id": "accuracy",
              "prompt": "Your click distance to circle center",
